# ==========================================
# LearnLens AI: Environment Configuration
# ==========================================

# Server Deployment Settings
NODE_ENV=production
PORT=5001

# Cross-Origin Resource Sharing (CORS)
# Set your production frontend domain (e.g. https://learning-web-w71q.onrender.com)
CORS_ORIGIN=https://learning-web-w71q.onrender.com

# Authentication & Security Secrets
# Replace with a high-entropy 64-character secret in production
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
LECTURER_INVITE_KEY=FACULTY_VERIFIED_KEY_2026

# AI Model Provider Credentials (Server-Side Only - Never Exposed to Frontend)
# LearnLens automatically defaults to deterministic high-fidelity generation if unset.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Persistent SQLite Database Path (Optional override)
# DATABASE_PATH=server/data/learnlens.db
