{
  "name": "learnlens-academic-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run dev\"",
    "start": "tsx server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx server/testSecurity.ts && tsx server/testDocumentExtraction.ts && tsx server/runSystemTracker.ts && tsx server/runRoadmapAudit.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.66.0"
  }
}
